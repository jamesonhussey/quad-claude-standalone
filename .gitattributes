# Normalize text files to LF in the repo; check out per-file as appropriate.
* text=auto

# Shell scripts MUST stay LF — CRLF breaks the shebang on macOS/Linux/Git Bash.
*.sh text eol=lf

# Windows-only scripts stay CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch line endings.
*.wav binary
*.ico binary
*.png binary
