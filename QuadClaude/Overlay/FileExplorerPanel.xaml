<Window x:Class="QuadClaude.Overlay.FileExplorerPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuadClaude.Overlay"
        WindowStyle="None"
        Background="#FF1E1E2E"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="250">

    <Window.Resources>
        <local:DirColorConverter x:Key="DirColorConverter"/>

        <!-- Dark scrollbar thumb -->
        <Style TargetType="Thumb" x:Key="DarkThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#55AAAACC" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark vertical scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DarkThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer glow border -->
    <Border BorderThickness="2" BorderBrush="#5544AAFF" CornerRadius="2">
    <!-- Inner content border -->
    <Border ClipToBounds="True" BorderThickness="1" BorderBrush="#3366CCFF" CornerRadius="1">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="#22FFFFFF" Padding="8,6">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#22FFFFFF" CornerRadius="4"
                            Padding="6,2" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="OnCloseClick">
                        <TextBlock Text="&#x2190;" Foreground="#999AAA" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border DockPanel.Dock="Left" Background="#22FFFFFF" CornerRadius="4"
                            Padding="6,2" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="OnGoUpClick"
                            ToolTip="Go up one directory">
                        <TextBlock Text="&#x2191;" Foreground="#999AAA" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HeaderText" Text="Files" Foreground="#EEEEF0"
                               FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
            </Border>

            <!-- Search box -->
            <Border DockPanel.Dock="Top" Padding="6,4">
                <Border Background="#22FFFFFF" CornerRadius="4">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             Foreground="#EEEEF0"
                             CaretBrush="#EEEEF0"
                             BorderThickness="0"
                             FontSize="10"
                             FontFamily="Segoe UI"
                             Padding="6,3"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged"/>
                </Border>
            </Border>

            <!-- Tree view -->
            <TreeView x:Name="FileTree"
                      Background="#001E1E2E"
                      BorderThickness="0"
                      Padding="4,2"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#EEEEF0"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EEEEF0"/>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Foreground" Value="#EEEEF0"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Segoe UI"/>
                        <Setter Property="Padding" Value="2,1"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:FileTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1"
                                    MouseRightButtonDown="OnNodeRightClick"
                                    MouseLeftButtonDown="OnNodeMouseDown"
                                    MouseMove="OnNodeMouseMove"
                                    Tag="{Binding}">
                            <TextBlock Text="{Binding Icon}" FontSize="10" Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding IsDirectory,
                                           Converter={StaticResource DirColorConverter}}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       ToolTip="{Binding FullPath}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Border>
    </Border>
</Window>
